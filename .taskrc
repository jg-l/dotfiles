# [Created by task 3.4.2 7/11/2026 21:14:30]
data.location=/Users/j/.task
news.version=3.4.2

report.todo.description=Not started
report.todo.columns=id,description,project,tags
report.todo.labels=ID,Task,Project,Tags
report.todo.filter=status:pending -ACTIVE
report.todo.sort=urgency-

report.active.columns=id,description,project,tags
report.active.labels=ID,Task,Project,Tags

report.completed.columns=id,description,project,tags
report.completed.labels=ID,Task,Project,Tags


### Inbox report
report.inbox.description=Waiting tasks, newest first
report.inbox.columns=id,description,tags,entry.age,scheduled.remaining,wait.remaining
report.inbox.labels=ID,Description,Tags,Age,Scheduled,Wait
report.inbox.filter=status:waiting
report.inbox.sort=entry-

### Complete

report.complete.description=Tasks completed today
report.complete.columns=uuid.short,description,end
report.complete.labels=ID,Description,Completed
report.complete.filter=status:completed and end.after:today
report.complete.sort=end+


